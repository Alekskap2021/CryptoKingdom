{
 "name": "cryptokingdom",
 "private": true,
 "type": "module",
 "imports": {
  "#/*": "./src/*"
 },
 "scripts": {
  "branch": "npx @elsikora/git-branch-lint -b",
  "build": "vite build",
  "check": "prettier --write . && eslint --fix",
  "commit": "cz",
  "dev": "vite dev --port 3005",
  "format": "prettier --check .",
  "format:fix": "prettier --write .",
  "lint": "eslint ./",
  "lint:all": "npm run lint && npm run lint:types",
  "lint:all:fix": "npm run lint:fix && npm run lint:types:fix",
  "lint:fix": "eslint --fix ./",
  "lint:types": "tsc --noEmit",
  "lint:types:fix": "tsc --noEmit --skipLibCheck",
  "prepare": "husky",
  "preview": "vite preview",
  "release": "semantic-release",
  "test": "vitest run"
 },
 "dependencies": {
  "@base-ui/react": "^1.4.0",
  "@modelcontextprotocol/sdk": "^1.27.1",
  "@neondatabase/serverless": "^1.1.0",
  "@tailwindcss/vite": "^4.1.18",
  "@tanstack/react-devtools": "latest",
  "@tanstack/react-query": "latest",
  "@tanstack/react-query-devtools": "latest",
  "@tanstack/react-router": "latest",
  "@tanstack/react-router-devtools": "latest",
  "@tanstack/react-router-ssr-query": "latest",
  "@tanstack/react-start": "latest",
  "@tanstack/react-table": "^8.21.3",
  "@tanstack/router-plugin": "^1.132.0",
  "axios": "^1.15.0",
  "better-auth": "^1.6.3",
  "bybit-api": "^4.6.1",
  "clsx": "^2.1.1",
  "dotenv": "^17.4.2",
  "drizzle-orm": "^0.45.2",
  "lightweight-charts": "^5.1.0",
  "lucide-react": "^0.545.0",
  "react": "^19.2.0",
  "react-dom": "^19.2.0",
  "recharts": "^3.8.1",
  "tailwind-merge": "^3.5.0",
  "tailwindcss": "^4.1.18",
  "zod": "^4.3.6"
 },
 "devDependencies": {
  "@commitlint/cli": "^20.5.0",
  "@commitlint/config-conventional": "^20.5.0",
  "@conarti/eslint-plugin-feature-sliced": "^1.0.5",
  "@elsikora/commitizen-plugin-commitlint-ai": "^2.5.0",
  "@elsikora/eslint-plugin-markdown": "^6.2.3",
  "@elsikora/git-branch-lint": "^1.2.2",
  "@eslint-react/eslint-plugin": "^2.10.0",
  "@eslint/js": "^9.39.4",
  "@saithodev/semantic-release-backmerge": "^4.0.1",
  "@semantic-release/changelog": "^6.0.3",
  "@semantic-release/commit-analyzer": "^13.0.1",
  "@semantic-release/git": "^10.0.1",
  "@semantic-release/github": "^12.0.6",
  "@semantic-release/npm": "^13.1.5",
  "@semantic-release/release-notes-generator": "^14.1.0",
  "@tailwindcss/typography": "^0.5.16",
  "@tanstack/devtools-vite": "latest",
  "@tanstack/eslint-config": "latest",
  "@tanstack/eslint-plugin-query": "^5.99.0",
  "@tanstack/eslint-plugin-router": "^1.161.6",
  "@testing-library/dom": "^10.4.1",
  "@testing-library/react": "^16.3.0",
  "@types/node": "^22.10.2",
  "@types/react": "^19.2.0",
  "@types/react-dom": "^19.2.0",
  "@typescript-eslint/eslint-plugin": "^8.58.2",
  "@typescript-eslint/parser": "^8.58.2",
  "@vitejs/plugin-react": "^6.0.1",
  "commitizen": "^4.3.1",
  "conventional-changelog-conventionalcommits": "^9.3.1",
  "drizzle-kit": "^0.31.10",
  "eslint": "^9.39.4",
  "eslint-config-prettier": "^10.1.8",
  "eslint-plugin-better-tailwindcss": "^4.4.1",
  "eslint-plugin-import": "^2.32.0",
  "eslint-plugin-jsonc": "^3.1.2",
  "eslint-plugin-jsx-a11y": "^6.10.2",
  "eslint-plugin-n": "^17.24.0",
  "eslint-plugin-package-json": "^0.91.1",
  "eslint-plugin-perfectionist": "^5.8.0",
  "eslint-plugin-prettier": "^5.5.5",
  "eslint-plugin-react": "^7.37.5",
  "eslint-plugin-sonarjs": "^4.0.2",
  "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
  "eslint-plugin-yml": "^3.3.1",
  "globals": "^17.5.0",
  "husky": "^9.1.7",
  "jsdom": "^28.1.0",
  "jsonc-eslint-parser": "^3.1.0",
  "lint-staged": "^16.4.0",
  "prettier": "^3.8.3",
  "prettier-plugin-tailwindcss": "^0.7.2",
  "semantic-release": "^25.0.3",
  "tsx": "^4.21.0",
  "typescript": "^5.7.2",
  "typescript-eslint": "^8.58.2",
  "vite": "^8.0.0",
  "vitest": "^3.0.5",
  "yaml-eslint-parser": "^2.0.0"
 },
 "pnpm": {
  "onlyBuiltDependencies": [
   "esbuild",
   "lightningcss"
  ]
 },
 "overrides": {
  "@elsikora/commitizen-plugin-commitlint-ai": {
   "@elsikora/cladi": "2.0.2"
  }
 },
 "config": {
  "commitizen": {
   "path": "@elsikora/commitizen-plugin-commitlint-ai"
  }
 }
}
